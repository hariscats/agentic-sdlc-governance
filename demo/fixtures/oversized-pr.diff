+def export_rows(categories: Iterable[str]) -> list[tuple[str, str, str]]:
+    """Export (category, code, prompt) rows for the given categories."""
+    wanted = set(categories)
+    return [
+        (kind, code, text)
+        for code, (kind, text) in sorted(CHECKLIST.items())
+        if kind in wanted
+    ]
